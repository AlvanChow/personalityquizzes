{
  "name": "my-personality-quizzes-ios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Capacitor iOS shell for mypersonalityquizzes.com — see README.md",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "build:web": "npm --prefix .. run build",
    "sync": "npm run build:web && cap sync ios",
    "copy": "npm run build:web && cap copy ios",
    "open": "open ios/App/App.xcodeproj",
    "doctor": "cap doctor ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "sharp": "^0.35.3"
  }
}
