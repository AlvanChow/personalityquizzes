<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App-target privacy manifest. Capacitor ships its own manifest for the
	  framework (node_modules/@capacitor/ios/Capacitor/Capacitor/PrivacyInfo.xcprivacy),
	  which declares no accessed APIs; this one covers the binary itself.

	  Apple aggregates every manifest in the app into a privacy report. It does
	  NOT replace the App Privacy questionnaire in App Store Connect — the two
	  must agree, so keep this in sync with what is declared there and with the
	  event allowlist in ../../../../src/utils/analytics.js.
	-->

	<!-- No advertising, no cross-app measurement, no third-party analytics SDK.
	     Analytics are first-party rows written to our own Supabase project and
	     the user can opt out (isAnalyticsOptedOut in src/utils/analytics.js). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Required-reason APIs. The app target's own code is the Capacitor
	     template's AppDelegate/SceneDelegate: no UserDefaults, no file
	     timestamps, no disk space, no system boot time. Empty is accurate;
	     if a plugin that touches one is ever added, it declares its own. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- From the OAuth provider (Google / Apple) at sign-in. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Quiz answers and results, stored against the account so the
		     dashboard, Circle comparisons, and share links work. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The analytics_events allowlist: page views, quiz funnel, share and
		     Circle actions. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
